{
  "name": "dsh-windows-distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible Windows distribution tooling for DeepSeek Harness",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "build:windows": "node scripts/build-windows.mjs",
    "checkout:upstream": "node scripts/checkout-pinned-upstream.mjs",
    "lock:distribution": "node scripts/lock-distribution.mjs --write",
    "prepare:distribution-components": "node scripts/apply-distribution-components.mjs",
    "test": "node --test",
    "validate:example": "node scripts/validate-distribution.mjs examples/desktop-distribution.json --root examples/payload",
    "validate:runtime-lock:fixture": "node scripts/verify-runtime-lock.mjs fixtures/primary-runtime-lock.minimal.json",
    "validate:upstream-pin": "node scripts/validate-upstream-pin.mjs upstream.lock.json",
    "verify:distribution-lock": "node scripts/lock-distribution.mjs --check",
    "verify:upstream-checkout": "node scripts/verify-upstream-checkout.mjs"
  }
}
